# ==============================================================================
# SERVERLESS ANTI-CHEAT CONTEST & SANDBOX PLATFORM - ENVIRONMENT CONFIGURATION
# Storage Engine: Supabase Storage (Private 'stages' bucket)
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE DATABASE, REALTIME & STORAGE
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only service role key (NEVER expose to client; used for admin mutations, signed storage URLs & atomic RPCs)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# BREVO SMTP BULK MAILER (POOLED SMTP)
# ------------------------------------------------------------------------------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email@domain.com
BREVO_SMTP_KEY=xsmtp-your-generated-smtp-master-key
BREVO_SENDER_EMAIL=contests@aiclub.org
BREVO_SENDER_NAME="AI Club Contest Master"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# High-entropy secret key required to access /admin and execute privileged routes
ADMIN_SECRET_KEY=change-me-to-a-super-secure-high-entropy-secret-key-32chars

# Public Origin URL (used to generate participant access links: {{access_link}})
NEXT_PUBLIC_APP_URL=https://your-platform.netlify.app
