# ==============================================================================
# SERVERLESS ANTI-CHEAT CONTEST & SANDBOX PLATFORM - ENVIRONMENT CONFIGURATION
# Project: Pixel and Anomaly (Presented by AI Club)
# Storage Engine: Supabase Storage (Private 'stages' bucket)
# Auth Engine: Firebase Auth (Google OAuth One-Tap Single Sign-On)
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE DATABASE, REALTIME & STORAGE
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only service role key (NEVER expose to client; used for admin mutations, signed storage URLs & atomic RPCs)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# SUPABASE S3-COMPATIBLE STORAGE GATEWAY (OPTIONAL / DIRECT S3 ACCESS)
# ------------------------------------------------------------------------------
# The platform accesses Supabase Storage natively using the Supabase URL and Service Role Key above.
# If you wish to connect external S3 tools or AWS S3 SDK to your Supabase Storage bucket,
# generate S3 credentials in Supabase Dashboard -> Project Settings -> Storage -> S3 Access Keys:
SUPABASE_S3_ENDPOINT=https://your-project-id.storage.supabase.co/s3
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=stages

# ------------------------------------------------------------------------------
# FIREBASE CLIENT (GOOGLE OAUTH SINGLE SIGN-ON & AUTHENTICATION)
# ------------------------------------------------------------------------------
# SETUP CHECKLIST IN FIREBASE CONSOLE:
# 1. Sign-in Method: Firebase Console -> Authentication -> Sign-in method -> Google (Click 'Enable' & Save)
# 2. Authorized Domains: Firebase Console -> Authentication -> Settings -> Authorized Domains
#    Ensure 'localhost' and your deployment host (e.g. 127.0.0.1 or your domain) are listed to prevent auto-closing popups!
# Obtain credentials from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1029384756
NEXT_PUBLIC_FIREBASE_APP_ID=1:1029384756:web:98a7b6c5d4e3f210

# ------------------------------------------------------------------------------
# BREVO SMTP BULK MAILER (POOLED SMTP)
# ------------------------------------------------------------------------------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email@domain.com
BREVO_SMTP_KEY=xsmtp-your-generated-smtp-master-key
BREVO_SENDER_EMAIL=contests@aiclub.org
BREVO_SENDER_NAME="AI Club Contest Master"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# High-entropy secret key required to access /admin and execute privileged routes
ADMIN_SECRET_KEY=change-me-to-a-super-secure-high-entropy-secret-key-32chars

# Public Origin URL (used to generate participant access links: {{access_link}})
NEXT_PUBLIC_APP_URL=https://your-platform.netlify.app
